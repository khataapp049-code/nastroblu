# Copy to .env on the server — never commit real values
# Required. Live and local must use the same MongoDB Atlas connection string.
MONGODB_URI=mongodb://USER:PASSWORD@your-atlas-host:27017/nastroblu?ssl=true&replicaSet=your-replica-set&authSource=admin
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@nastroblu.in
ADMIN_PASSWORD=use-a-long-unique-password
CORS_ORIGIN=https://nastroblu.in,https://www.nastroblu.in

# Live Google reviews on the homepage (Places API).
# Without these, the site shows a saved copy in server/src/data/google-reviews.json
# and will NOT match new reviews on Google.
# Enable Places API (Place Details) on the key, then set:
# GOOGLE_MAPS_API_KEY=your-key
# GOOGLE_PLACE_ID=ChIJ...  (from Google Maps → the Nastro Blu listing)
